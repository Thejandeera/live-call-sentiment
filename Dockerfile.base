FROM python:3.11-slim

WORKDIR /app

COPY requirements-base.txt .

RUN apt-get update && apt-get install -y binutils \
    && pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r requirements-base.txt \
    && python -m spacy download en_core_web_sm \
    && (find /usr/local/lib/python3.11/site-packages -name "*.so" -exec strip --strip-unneeded {} + 2>/dev/null || true) \
    && apt-get remove -y binutils && apt-get autoremove -y && rm -rf /var/lib/apt/lists/* \
    && find /usr/local/lib/python3.11 -type d -name "__pycache__" -exec rm -r {} +