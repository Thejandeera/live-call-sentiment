
# 1. API Gateway Configuration (Port 8000)
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000

# Allowed CORS Origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Downstream Microservice Endpoints called by API Gateway
PHRASE_SERVICE_URL=http://localhost:8002/extract-keywords
SENTIMENT_SERVICE_URL=http://localhost:8003/analyze-sentiment
SCORE_SERVICE_URL=http://localhost:8004/calculate-score


# 2. Phrase Extraction Service Configuration (Port 8002)
PHRASE_SERVICE_HOST=0.0.0.0
PHRASE_SERVICE_PORT=8002

# MongoDB Database Connection String 
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.brmomc5.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=live_call_sentiment
MONGODB_COLLECTION_NAME=keywords

# spaCy language model for NLP parsing and tokenization
SPACY_MODEL=en_core_web_sm

# 3. Sentiment & Emotion Service Configuration (Port 8003)
SENTIMENT_SERVICE_HOST=0.0.0.0
SENTIMENT_SERVICE_PORT=8003

# Hugging Face Transformer model repository
SENTIMENT_MODEL_NAME=SamLowe/roberta-base-go_emotions

# 4. Live Sentiment Score Service Configuration (Port 8004)
SCORE_SERVICE_HOST=0.0.0.0
SCORE_SERVICE_PORT=8004

# Threshold triggering supervisor escalation alert
ESCALATION_THRESHOLD=-65.0
